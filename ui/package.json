    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/typescript-estree": "^8.46.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^25.0.1",
    "oxlint": "^0.15.0",
