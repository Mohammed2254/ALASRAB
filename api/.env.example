# انسخه إلى .env واملأه. لا قيمة سرّية في الكود إطلاقًا.

DATABASE_URL=postgresql+psycopg://asrab:asrab_dev_only@127.0.0.1:5434/asrab_v2
TEST_DATABASE_URL=postgresql+psycopg://asrab:asrab_dev_only@127.0.0.1:5434/asrab_v2_test

# ولّد واحدًا لكل بيئة — تكراره بين التطوير والإنتاج يعني أن جلسة مزوّرة محليًّا
# تعمل هناك:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# المتصفّح يرفض الكوكي الآمن على http: محليًّا false، وخلف HTTPS true.
SESSION_COOKIE_SECURE=false

# ADR-006: فحص Origin على كل طلب مغيِّر للحالة. قائمة مفصولة بفاصلة.
# نسيانها يكسر كل الطلبات المغيّرة — عطل صاخب لا صامت، وهذا مقصود.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# واجهة العقد /docs — للتطوير وحدها. الافتراض معطَّل: خريطة كل مسار وكل حقل
# على خادم حيّ هي سطح هجوم جاهز.
EXPOSE_API_DOCS=true

FLASK_APP=app:create_app
FLASK_DEBUG=0
