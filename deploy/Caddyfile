# طبقة TLS والواجهة العامّة الوحيدة. التطبيق لا يُعرَّض مباشرةً أبدًا
# (`expose` لا `ports` في `docker-compose.prod.yml`).

{$DOMAIN} {
	# شهادة Let's Encrypt تلقائية بالكامل — لا إعداد إضافيّ طالما DNS يشير هنا.
	reverse_proxy app:8000 {
		# **مهلةٌ أقصر من مهلة gunicorn (٦٠ث)**: الوكيل يستسلم أوّلًا فيردّ ٥٠٤
		# ويحرّر الاتصال، بدل أن ينتظر عاملًا سيُقتَل على أيّ حال.
		transport http {
			read_timeout 50s
		}
	}

	# `zstd` قبل `gzip`: المتصفّحات الحديثة تختاره وهو أصغر على نصٍّ عربيّ،
	# والقديمة تسقط إلى gzip. والخطوط `woff2` مضغوطةٌ أصلًا فلا تُعاد.
	encode zstd gzip

	# **السجلّ إلى stdout لا إلى ملفّ**: تدويرُه يملكه Docker
	# (`x-logging` في `docker-compose.prod.yml`)، وملفٌّ داخل الحاوية ينمو
	# بلا حارس حتى يملأ القرص.
	log {
		output stdout
		format console
	}

	# **ولا ترويسات أمان هنا.** يكتبها التطبيق على كل ردّ (`app/__init__.py`
	# · `API.md §١`)، وتكرارُها في طبقتين يعني أن تعديل إحداهما يُنتج
	# سياستين متناقضتين — ومن يقرأ الكود لا يعرف أيُّهما السارية.
}
